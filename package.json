{
  "name": "vsolcli",
  "displayName": "VS Code olcli Sync",
  "icon": "resources/icon.png",
  "description": "Automatically sync and compile Overleaf projects with olcli.",
  "version": "0.1.2",
  "license": "MIT",
  "publisher": "BunnyLutts",
  "repository": {
    "type": "git",
    "url": "https://github.com/BunnyLutts/vsolcli.git"
  },
  "homepage": "https://github.com/BunnyLutts/vsolcli#readme",
  "bugs": {
    "url": "https://github.com/BunnyLutts/vsolcli/issues"
  },
  "keywords": ["overleaf", "latex", "sync", "pdf"],
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "olcli.sync",
        "title": "olcli: Sync Project",
        "icon": {
          "light": "resources/icons/light/sync.svg",
          "dark": "resources/icons/dark/sync.svg"
        }
      },
      {
        "command": "olcli.compile",
        "title": "olcli: Compile Project",
        "icon": {
          "light": "resources/icons/light/compile.svg",
          "dark": "resources/icons/dark/compile.svg"
        }
      },
      {
        "command": "olcli.syncAndCompile",
        "title": "olcli: Sync and Compile Project",
        "icon": {
          "light": "resources/icons/light/sync-compile.svg",
          "dark": "resources/icons/dark/sync-compile.svg"
        }
      },
      {
        "command": "olcli.login",
        "title": "olcli: Login to Self-hosted Overleaf",
        "icon": {
          "light": "resources/icons/light/login.svg",
          "dark": "resources/icons/dark/login.svg"
        }
      },
      {
        "command": "olcli.listProjects",
        "title": "olcli: List Projects",
        "icon": {
          "light": "resources/icons/light/refresh.svg",
          "dark": "resources/icons/dark/refresh.svg"
        }
      },
      {
        "command": "olcli.pullProject",
        "title": "olcli: Pull Project",
        "icon": {
          "light": "resources/icons/light/pull.svg",
          "dark": "resources/icons/dark/pull.svg"
        }
      },
      {
        "command": "olcli.openPdfPreview",
        "title": "olcli: Open PDF Preview",
        "icon": {
          "light": "resources/icons/light/preview.svg",
          "dark": "resources/icons/dark/preview.svg"
        }
      },
      {
        "command": "olcli.syncAndCompileCurrent",
        "title": "olcli: Sync and Compile",
        "icon": {
          "light": "resources/icons/light/sync-compile.svg",
          "dark": "resources/icons/dark/sync-compile.svg"
        }
      },
      {
        "command": "olcli.resolveConflictsLocal",
        "title": "olcli: Resolve Conflicts (Keep Local)",
        "icon": {
          "light": "resources/icons/light/keep-local.svg",
          "dark": "resources/icons/dark/keep-local.svg"
        }
      },
      {
        "command": "olcli.resolveConflictsRemote",
        "title": "olcli: Resolve Conflicts (Keep Remote)",
        "icon": {
          "light": "resources/icons/light/keep-remote.svg",
          "dark": "resources/icons/dark/keep-remote.svg"
        }
      }
    ],
    "views": {
      "olcli": [
        {
          "id": "olcli.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "olcli",
          "title": "olcli",
          "icon": "resources/olcli-v2.svg"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "olcli.syncAndCompileCurrent",
          "when": "(editorLangId == latex || resourceExtname == .tex) && !olcli.conflictDiffActive",
          "group": "navigation@10"
        },
        {
          "command": "olcli.openPdfPreview",
          "when": "(editorLangId == latex || resourceExtname == .tex) && !olcli.conflictDiffActive",
          "group": "navigation@11"
        },
        {
          "command": "olcli.sync",
          "when": "isInDiffEditor && olcli.conflictDiffActive",
          "group": "navigation@2"
        },
        {
          "command": "olcli.resolveConflictsLocal",
          "when": "isInDiffEditor && olcli.conflictDiffActive",
          "group": "navigation@0"
        },
        {
          "command": "olcli.resolveConflictsRemote",
          "when": "isInDiffEditor && olcli.conflictDiffActive",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "olcli.login",
          "when": "view == olcli.projects",
          "group": "navigation"
        },
        {
          "command": "olcli.listProjects",
          "when": "view == olcli.projects",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "olcli",
      "properties": {
        "olcli.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic olcli actions."
        },
        "olcli.autoSyncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run olcli sync when a document is saved."
        },
        "olcli.autoCompileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile after an automatic save sync succeeds."
        },
        "olcli.autoSyncInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Seconds between background syncs that run without a save. 0 disables them. Background syncs never compile, and are skipped while an editor in the project has unsaved changes."
        },
        "olcli.disableLatexWorkshopOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Disable LaTeX Workshop's onSave and onFileChange auto builds so olcli handles cloud compilation."
        },
        "olcli.pdfOutput": {
          "type": "string",
          "default": "./.build/{文件名}.pdf",
          "description": "PDF path relative to the project root. {文件名} is replaced by the saved TeX file name. The preview uses this path first, then falls back to the newest PDF in that directory."
        },
        "olcli.autoRefreshPreview": {
          "type": "boolean",
          "default": true,
          "description": "Reload the split PDF preview after cloud compilation downloads a new PDF."
        },
        "olcli.syncOnConfigurationChange": {
          "type": "boolean",
          "default": true,
          "description": "Run sync and compile when olcli settings change."
        },
        "olcli.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Project directory. Empty uses the first workspace folder."
        },
        "olcli.executable": {
          "type": "string",
          "default": "",
          "description": "Empty uses bundled olcli. Set a command or absolute path to use an external installation."
        },
        "olcli.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Self-hosted Overleaf URL, for example https://overleaf.example.com."
        },
        "olcli.cookieName": {
          "type": "string",
          "default": "overleaf_session2",
          "description": "Session cookie name used by the server."
        },
        "olcli.servers": {
          "type": "array",
          "default": [],
          "description": "Configured self-hosted Overleaf servers. Login adds entries automatically."
        },
        "olcli.debounceMs": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "description": "Delay before an automatic action starts."
        },
        "olcli.compileTimeout": {
          "type": "number",
          "default": 120000,
          "minimum": 1000,
          "description": "Cloud compile HTTP timeout in milliseconds. The underlying olcli default is 10000, which a full LaTeX compile routinely exceeds."
        },
        "olcli.syncTimeout": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "HTTP timeout in milliseconds for the conflict-aware sync (whole-project download and per-file uploads)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@aloth/olcli": "0.13.0",
    "pdfjs-dist": "3.11.174"
  }
}
